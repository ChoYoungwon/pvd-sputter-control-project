#-----------------------------------------------------------
# Setpoint Interlock
#-----------------------------------------------------------

action ( doPVDDryPumpPower_LED == ON ) {
		condition ( doPVDFastVentValve_LED == Open || doPVDSlowVentValve_LED == Open ) $alarm=961;
}

action ( doPVDTurboPumpPower_LED == ON ) {
		condition ( doPVDFastVentValve_LED == Open || doPVDSlowVentValve_LED == Open ) $alarm = 962;
}

