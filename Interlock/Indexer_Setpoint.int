
##--------------------------------------------------------------------------------
## TM Interlock - RB Arm
##--------------------------------------------------------------------------------

action ( doRbXRetExt == 1 ) {
		condition ( diRbBusySts == 1 || diRbHomingSts == 0 ) $alarm = 160;
}

action ( aoRbAbsPos == * ) {
		condition ( diRbExtendSen == 1 || diRbRetractSen == 0 ) $alarm = 161;
}

